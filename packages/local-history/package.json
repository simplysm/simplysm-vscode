{
  "name": "simplysm-local-history",
  "displayName": "Simplysm Local History",
  "version": "1.0.9",
  "private": true,
  "license": "Apache-2.0",
  "keywords": [
    "local history",
    "history",
    "backup",
    "restore",
    "rollback",
    "snapshot",
    "webstorm"
  ],
  "description": "%description%",
  "publisher": "simplysm",
  "repository": {
    "type": "git",
    "url": "https://github.com/simplysm/simplysm-vscode.git",
    "directory": "packages/local-history"
  },
  "files": [
    "LICENSE",
    "CHANGELOG.md",
    "dist/**/*.cjs",
    "images/icon.png",
    "images/show-history.png",
    "l10n/*.json",
    "package.nls.json",
    "package.nls.ko.json"
  ],
  "icon": "images/icon.png",
  "l10n": "./l10n",
  "type": "module",
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "minimatch": "^10.1.1"
  },
  "contributes": {
    "commands": [
      {
        "command": "simplysm-local-history.showHistory",
        "title": "%command.showHistory.title%",
        "category": "Simplysm Local History"
      },
      {
        "command": "simplysm-local-history.restore",
        "title": "%command.restore.title%",
        "category": "Simplysm Local History",
        "icon": "$(discard)"
      },
      {
        "command": "simplysm-local-history.openBeforeInDefaultApp",
        "title": "%command.openBeforeInDefaultApp.title%",
        "category": "Simplysm Local History"
      },
      {
        "command": "simplysm-local-history.openAfterInDefaultApp",
        "title": "%command.openAfterInDefaultApp.title%",
        "category": "Simplysm Local History"
      },
      {
        "command": "simplysm-local-history.loadMore",
        "title": "%command.loadMore.title%",
        "category": "Simplysm Local History"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "simplysm-local-history.showHistory",
          "when": "resourceScheme == file",
          "group": "7_localhistory"
        }
      ],
      "commandPalette": [
        {
          "command": "simplysm-local-history.restore",
          "when": "false"
        },
        {
          "command": "simplysm-local-history.openBeforeInDefaultApp",
          "when": "false"
        },
        {
          "command": "simplysm-local-history.openAfterInDefaultApp",
          "when": "false"
        },
        {
          "command": "simplysm-local-history.loadMore",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "simplysm-local-history.restore",
          "when": "view == simplysm-local-history.view && viewItem =~ /^(row|folder|file)(\\.|$)/ && !simplysm-local-history.restoring",
          "group": "inline"
        },
        {
          "command": "simplysm-local-history.openBeforeInDefaultApp",
          "when": "view == simplysm-local-history.view && viewItem =~ /^(row|file)\\.before/ && !remoteName",
          "group": "1_open@1"
        },
        {
          "command": "simplysm-local-history.openAfterInDefaultApp",
          "when": "view == simplysm-local-history.view && viewItem =~ /^(row|file)(\\.before)?\\.after$/ && !remoteName",
          "group": "1_open@2"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "simplysm-local-history.view",
          "name": "%view.name%",
          "when": "simplysm-local-history.active"
        }
      ]
    },
    "configuration": {
      "title": "Simplysm Local History",
      "properties": {
        "simplysm-local-history.exclude": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          },
          "scope": "resource",
          "default": {
            "**/.git": true,
            "**/node_modules": true,
            "**/dist": true,
            "**/out": true,
            "**/.vscode-test": true
          },
          "description": "%config.exclude.description%"
        }
      }
    }
  },
  "activationEvents": [
    "onStartupFinished",
    "onFileSystem:simplysm-local-history"
  ],
  "engines": {
    "vscode": "^1.127.0"
  }
}

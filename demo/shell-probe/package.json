{
  "name": "shell-probe",
  "displayName": "Simplysm demo shell probe",
  "description": "Demo harness only (not a product): reports the default shell VS Code chose.",
  "publisher": "simplysm-demo",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "vscode": "^1.127.0"
  },
  "main": "./extension.cjs",
  "activationEvents": [
    "*"
  ],
